    def _aba_teclado(self):
        g = self._grade()
        # valores do arquivo que não estão nas listas entram nelas (não se perdem)
        atual = teclado_ler()
        self.kb_layouts = list(TECLADO_LAYOUTS)
        for cod in (atual["kb_layout1"], atual["kb_layout2"]):
            if cod and cod not in [c for c, _ in self.kb_layouts]:
                self.kb_layouts.append((cod, cod))
        self.kb_layouts2 = [("", "— nenhum —")] + self.kb_layouts
        self.kb_modelos = list(TECLADO_MODELOS)
        if atual["kb_modelo"] not in [c for c, _ in self.kb_modelos]:
            self.kb_modelos.append((atual["kb_modelo"], atual["kb_modelo"]))
        self.kb_trocas = list(TECLADO_TROCAS)
        if atual["kb_troca"] not in [c for c, _ in self.kb_trocas]:
            self.kb_trocas.append((atual["kb_troca"], atual["kb_troca"]))

        self.dd_kb1 = self._lista(g, "Layout principal", [t for _, t in self.kb_layouts],
                                  "O ABNT2 é o teclado brasileiro com Ç.")
        self.dd_kb2 = self._lista(g, "Segundo layout", [t for _, t in self.kb_layouts2])
        self.dd_kb_modelo = self._lista(g, "Modelo", [t for _, t in self.kb_modelos],
                                        "ABNT2 acerta as teclas a mais do teclado "
                                        "brasileiro (/? e o ponto do teclado numérico).")
        self.dd_kb_troca = self._lista(g, "Trocar de layout", [t for _, t in self.kb_trocas],
                                       "Atalho para alternar entre os dois layouts.")
        if not sessao_wayland():
            for dd in (self.dd_kb1, self.dd_kb2, self.dd_kb_modelo, self.dd_kb_troca):
                dd.set_sensitive(False)
            aviso = Gtk.Label(xalign=0)
            aviso.add_css_class("dica")
            aviso.set_wrap(True)
            aviso.set_markup("ℹ️ <b>Sessão X11.</b> Aqui o teclado é configurado pelo app "
                             "<b>Teclado</b> do XFCE. Esta aba vale para o XFCE em Wayland.")
            g.attach(aviso, 0, g._linha, 3, 1)
            g._linha += 1
            botao = Gtk.Button(label="⌨️ Abrir o Teclado do XFCE")
            botao.set_halign(Gtk.Align.START)
            botao.connect("clicked", lambda _b: rodar(["sh", "-c",
                                                       "xfce4-keyboard-settings >/dev/null 2>&1 &"]))
            g.attach(botao, 0, g._linha, 3, 1)
            g._linha += 1
        return g

    def abrir_aba_teclado(self):
        self.abas.set_current_page(self.pagina_teclado)

    # ----- carregar / aplicar -----

    def _valores_atuais(self):
        v = dict(PADRAO)
        v["modo"] = ler_modo()
        v.update(ler_picom())

        paineis = ids_paineis()
        if paineis:
            rgba = xfconf_ler_lista("xfce4-panel", f"/panels/panel-{paineis[0]}/background-rgba")
            estilo = xfconf_ler("xfce4-panel", f"/panels/panel-{paineis[0]}/background-style")
            if estilo == "1" and len(rgba) == 4:
                v["painel"] = round(float(rgba[3]) * 100)
            else:
                v["painel"] = 100
        v["menus"] = ler_menus()
        whisker = ids_whisker()
        if whisker:
            op = xfconf_ler("xfce4-panel", f"/plugins/plugin-{whisker[0]}/menu-opacity")
            v["whisker"] = int(op) if op and op.isdigit() else 100
        modo_term = xfconf_ler("xfce4-terminal", "/background-mode")
        escuro = xfconf_ler("xfce4-terminal", "/background-darkness")
        if modo_term == "TERMINAL_BACKGROUND_TRANSPARENT" and escuro:
            v["terminal"] = round(float(escuro) * 100)
        else:
            v["terminal"] = 100

        v["tiling"] = tiling_ligado()
        v["layout"], v["espaco"] = ler_cortile()
        v["tema"] = xfconf_ler("xfwm4", "/general/theme") or PADRAO["tema"]
        if sessao_wayland():
            labwc = labwc_ler()
            if labwc.get("raio") and labwc["raio"].isdigit():
                v["raio"] = int(labwc["raio"])
            if labwc.get("sombras"):
                v["sombras"] = labwc["sombras"] == "yes"

        estado = ler_estado_mac()
        v["mac"] = estado["ativo"]
        v["mac_aparencia"] = estado["aparencia"]
        v["mac_cor"] = estado["cor"]
        v["mac_layout"] = estado["layout"]
        v.update(teclado_ler())
        return v

    def _mostrar(self, v):
        self.dd_modo.set_selected([m for m, _ in MODOS].index(v["modo"]))
        self.esc_blur.set_value(v["blur"])
        self.esc_raio.set_value(v["raio"])
        self.sw_sombras.set_active(v["sombras"])
        self.sw_fade.set_active(v["fade"])
        self.esc_foco.set_value(v["janela_foco"])
        self.esc_fundo.set_value(v["janela_fundo"])
        self.esc_painel.set_value(v["painel"])
        self.esc_menus.set_value(v["menus"])
        self.esc_whisker.set_value(v["whisker"])
        self.esc_terminal.set_value(v["terminal"])
        self.sw_tiling.set_active(v["tiling"])
        chaves = [chave for chave, _ in LAYOUTS]
        self.dd_layout.set_selected(chaves.index(v["layout"]) if v["layout"] in chaves else 0)
        self.esc_espaco.set_value(v["espaco"])
        if v["tema"] in self.temas:
            self.dd_tema.set_selected(self.temas.index(v["tema"]))
        self.sw_mac.set_active(v["mac"])
        aparencias = [a for a, _ in APARENCIAS]
        self.dd_aparencia.set_selected(aparencias.index(v["mac_aparencia"])
                                       if v["mac_aparencia"] in aparencias else 1)
        cores = [c for c, _ in CORES_MAC]
        self.dd_cor.set_selected(cores.index(v["mac_cor"]) if v["mac_cor"] in cores else 0)
        self.sw_layout_mac.set_active(v["mac_layout"])
        for dd, lista, chave in ((self.dd_kb1, self.kb_layouts, "kb_layout1"),
                                 (self.dd_kb2, self.kb_layouts2, "kb_layout2"),
                                 (self.dd_kb_modelo, self.kb_modelos, "kb_modelo"),
                                 (self.dd_kb_troca, self.kb_trocas, "kb_troca")):
            codigos = [c for c, _ in lista]
            if v[chave] in codigos:
                dd.set_selected(codigos.index(v[chave]))

    def _coletar(self):
        return {
            "modo": MODOS[self.dd_modo.get_selected()][0],
            "blur": int(self.esc_blur.get_value()),
            "raio": int(self.esc_raio.get_value()),
            "sombras": self.sw_sombras.get_active(),
            "fade": self.sw_fade.get_active(),
            "janela_foco": int(self.esc_foco.get_value()),
            "janela_fundo": int(self.esc_fundo.get_value()),
            "painel": int(self.esc_painel.get_value()),
            "menus": int(self.esc_menus.get_value()),
            "whisker": int(self.esc_whisker.get_value()),
            "terminal": int(self.esc_terminal.get_value()),
            "tiling": self.sw_tiling.get_active(),
            "layout": LAYOUTS[self.dd_layout.get_selected()][0],
            "espaco": int(self.esc_espaco.get_value()),
            "tema": self.temas[self.dd_tema.get_selected()] if self.temas else "",
            "mac": self.sw_mac.get_active(),
            "mac_aparencia": APARENCIAS[self.dd_aparencia.get_selected()][0],
            "mac_cor": CORES_MAC[self.dd_cor.get_selected()][0],
            "mac_layout": self.sw_layout_mac.get_active(),
            "kb_layout1": self.kb_layouts[self.dd_kb1.get_selected()][0],
            "kb_layout2": self.kb_layouts2[self.dd_kb2.get_selected()][0],
            "kb_modelo": self.kb_modelos[self.dd_kb_modelo.get_selected()][0],
            "kb_troca": self.kb_trocas[self.dd_kb_troca.get_selected()][0],
        }

    def carregar_valores(self):
        self._mostrar(self._valores_atuais())
        self.label_status.set_text(self._resumo_compositor())

    def _resumo_compositor(self):
        if sessao_wayland():
            return ("🌊 Sessão Wayland (labwc): cantos, sombras e moldura vão para o labwc; "
                    "desfoque, transparência de janelas e mosaico são só do X11.")
        log = ler_arquivo(LOG_PICOM).strip().splitlines()
        decisao = next((linha for linha in reversed(log) if linha.startswith("->")), "")
        rodando = subprocess.run(["pgrep", "-x", "picom"], capture_output=True).returncode == 0
        partes = ["✨ picom rodando" if rodando else "🪟 picom parado"]
        if decisao:
            partes.append(f"última decisão do voidbr-picom: {decisao[2:].strip()}")
        return "   •   ".join(partes)

    def ao_clicar_padrao(self, botao):
        self._mostrar(PADRAO)
        self.label_status.set_text("↩️ Valores padrão do VoidBR carregados. Clique em ✅ Aplicar.")

    def ao_clicar_aplicar(self, botao):
        v = self._coletar()
        self.botao_aplicar.set_sensitive(False)
        self.botao_padrao.set_sensitive(False)
        self.label_status.set_text("⏳ Aplicando…")
        threading.Thread(target=self._aplicar, args=(v,), daemon=True).start()

    def _aplicar(self, v):
        erros = []
        wayland = sessao_wayland()

        # --- Visual Mac primeiro: pode trocar os painéis e a moldura ---
        fundo = None
        estado = ler_estado_mac()
        try:
            if v["mac"]:
                estado = mac_aplicar(v, estado)
                fundo = FUNDO_MAC[v["mac_aparencia"]]
                v["tema"] = f"VoidBR-Mac-{v['mac_aparencia']}"
            elif estado["ativo"]:
                v["tema"] = mac_desligar(estado) or v["tema"]
        except (OSError, ET.ParseError) as e:
            erros.append(f"visual Mac: {e}")

        if not wayland:
            try:
                gravar_modo(v["modo"])
                gravar_picom(v)
            except OSError as e:
                erros.append(f"picom: {e}")
        elif not v["mac"]:
            # no Wayland, cantos e sombras são do labwc (o Visual Mac já gravou os dele)
            try:
                labwc_gravar({"raio": int(v["raio"]), "sombras": "yes" if v["sombras"] else "no"})
            except (OSError, ET.ParseError) as e:
                erros.append(f"labwc: {e}")

        if wayland:
            try:
                teclado_gravar(v)
            except OSError as e:
                erros.append(f"teclado: {e}")

        try:
            for pid in ids_paineis():
                base = f"/panels/panel-{pid}"
                rgba = xfconf_ler_lista("xfce4-panel", f"{base}/background-rgba")
                try:
                    cor = [float(x) for x in rgba[:3]] if len(rgba) == 4 else [0.0, 0.0, 0.0]
                except ValueError:
                    cor = [0.0, 0.0, 0.0]
                if fundo:
                    cor = list(fundo["rgb"])
                xfconf_gravar("xfce4-panel", f"{base}/background-style", "uint", 1)
                xfconf_gravar_rgba("xfce4-panel", f"{base}/background-rgba",
                                   cor + [v["painel"] / 100.0])
            for pid in ids_whisker():
                xfconf_gravar("xfce4-panel", f"/plugins/plugin-{pid}/menu-opacity",
                              "int", v["whisker"])
            xfconf_gravar("xfce4-terminal", "/background-mode", "string",
                          "TERMINAL_BACKGROUND_TRANSPARENT")
            xfconf_gravar("xfce4-terminal", "/background-darkness", "double",
                          f"{v['terminal'] / 100.0:.2f}")
            if v["tema"] and not wayland:
                xfconf_gravar("xfwm4", "/general/theme", "string", v["tema"])
        except Exception as e:  # noqa: BLE001 - mostrar qualquer falha no status
            erros.append(f"xfconf: {e}")

        try:
            gravar_menus(v["menus"], fundo)
        except OSError as e:
            erros.append(f"gtk.css: {e}")

        if not wayland:
            try:
                layout_antes = ler_cortile()[0]
                gravar_cortile(v["layout"], v["espaco"])
                subprocess.run(["voidbr-tiling", "on" if v["tiling"] else "off"],
                               capture_output=True)
                if v["tiling"] and v["layout"] != layout_antes:
                    # o cortile guarda o layout de cada área: esquece para valer o novo
                    subprocess.run(["voidbr-tiling", "reset"], capture_output=True)
            except (OSError, FileNotFoundError) as e:
                erros.append(f"cortile: {e}")

            try:
                subprocess.run(["voidbr-picom"], capture_output=True, timeout=30)
            except (OSError, subprocess.TimeoutExpired) as e:
                erros.append(f"voidbr-picom: {e}")

        GLib.idle_add(self._ao_concluir, erros)

    def _ao_concluir(self, erros):
        self.botao_aplicar.set_sensitive(True)
        self.botao_padrao.set_sensitive(True)
        self._mostrar(self._valores_atuais())
        if erros:
            self.label_status.set_text("❌ " + " | ".join(erros))
        else:
            self.label_status.set_text("✅ Aplicado.   •   " + self._resumo_compositor())
        return False

    # ----- fonte do app -----

    def aplicar_fonte(self):
        """Aplica a escala e a família da fonte em todas as janelas do app."""
        nome = Gtk.Settings.get_default().props.gtk_font_name or ""
        m = re.search(r"(\d+(?:\.\d+)?)\s*$", nome)
        base = float(m.group(1)) if m else 11.0
        s = self.escala
        fam = f' font-family: "{self.familia}";' if self.familia else ""
        sistema = _familia_segura(re.sub(r"[ ,]*[0-9.]+$", "", nome)) or "sans-serif"
        self.css_fonte.load_from_data((
            f"window, window * {{ font-size: {base * s:.1f}pt;{fam} }}\n"
            f".titulo-app {{ font-size: {20 * s:.0f}px; }}\n"
            f".subtitulo {{ font-size: {12 * s:.0f}px; }}\n"
            f".dica {{ font-size: {11 * s:.0f}px; }}\n"
            # a janela Aparência fica sempre na fonte do sistema (para dar para desfazer)
            f"window.aparencia, window.aparencia * {{ font-family: \"{sistema}\"; "
            f"font-size: {base:.1f}pt; }}\n"
            "window.aparencia .titulo-app { font-size: 20px; }\n").encode("utf-8"))
        # força o GTK a remedir e redesenhar todas as janelas com a fonte nova
        for w in Gtk.Window.list_toplevels():
            w.queue_resize()
            w.queue_draw()
        self.b_escala.set_label(f"{round(s * 100)}%")
        self.b_menor.set_sensitive(s > ESCALA_MIN + 0.001)
        self.b_maior.set_sensitive(s < ESCALA_MAX - 0.001)

    def mudar_fonte(self, passo):
        """passo: +1 aumenta, -1 diminui, 0 volta ao normal. Fica gravado."""
        nova = 1.0 if passo == 0 else round(self.escala + 0.1 * passo, 2)
        nova = min(ESCALA_MAX, max(ESCALA_MIN, nova))
        if nova == self.escala and passo:
            return
        self.escala = nova
        self.aplicar_fonte()
        try:
            gravar_prefs_app(font_scale=nova)
        except OSError:
            pass

    def ao_clicar_aparencia(self, *_):
        """Escolhe a família da fonte do app (o tamanho fica no A− / A+).

        A escolha só aparece na frase de exemplo; o app muda quando você salva."""
        sistema = Gtk.Settings.get_default().props.gtk_font_name or "Sans 11"
        familias = sorted({f.get_name() for f in self.get_pango_context().list_families()},
                          key=str.lower)
        opcoes = ["Padrão do sistema"] + familias
        escolha = [self.familia]

        dlg = Gtk.Window(title="Aparência", transient_for=self, modal=True,
                         default_width=520, resizable=False)
        dlg.add_css_class("aparencia")
        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for lado in ("top", "bottom", "start", "end"):
            getattr(caixa, f"set_margin_{lado}")(18)
        titulo = Gtk.Label(label="🔤 Aparência", xalign=0)
        titulo.add_css_class("titulo-app")
        caixa.append(titulo)
        texto = Gtk.Label(label="Fonte do VoidBR XFCE Tweaks (o tamanho continua nos botões "
                                "A− / A+). Escolha olhando o exemplo e clique em Salvar.",
                          xalign=0, wrap=True)
        texto.add_css_class("dica")
        caixa.append(texto)

        lista = Gtk.DropDown.new_from_strings(opcoes)
        lista.set_enable_search(True)
        lista.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        lista.set_hexpand(True)
        lista.set_selected(opcoes.index(self.familia) if self.familia in opcoes else 0)
        linha = Gtk.Box(spacing=8)
        linha.append(Gtk.Label(label="Fonte:", xalign=0))
        linha.append(lista)
        caixa.append(linha)

        # exemplo com a fonte escolhida (só este rótulo muda)
        previa = Gtk.Label(label="Efeitos, transparências, mosaico e Visual Mac.\n"
                                 "0123456789  áéíóú çãõ  ABC abc", xalign=0, wrap=True,
                           max_width_chars=56, height_request=56, hexpand=True)
        previa.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        quadro = Gtk.Box()
        quadro.add_css_class("cartao")
        quadro.append(previa)
        caixa.append(quadro)
        info = Gtk.Label(xalign=0, wrap=True)
        info.add_css_class("dica")
        caixa.append(info)

        def ao_mudar(*_):
            i = lista.get_selected()
            fam = "" if i in (0, Gtk.INVALID_LIST_POSITION) else _familia_segura(opcoes[i])
            escolha[0] = fam
            attrs = Pango.AttrList()
            if fam:
                attrs.insert(Pango.attr_family_new(fam))
            previa.set_attributes(attrs)
            info.set_markup(f"Em uso agora: <b>{GLib.markup_escape_text(self.familia or 'padrão do sistema')}</b>"
                            + ("" if self.familia else f" ({GLib.markup_escape_text(sistema)})"))
        lista.connect("notify::selected", ao_mudar)
        ao_mudar()

        def salvar(*_):
            try:
                gravar_prefs_app(font_family=escolha[0])
            except OSError as e:
                info.set_text(f"❌ Não foi possível salvar: {e}")
                return
            self.familia = escolha[0]
            self.aplicar_fonte()
            dlg.close()

        botoes = Gtk.Box(spacing=8, homogeneous=True)
        cancelar = Gtk.Button(label="❌ Cancelar")
        cancelar.add_css_class("botao-cinza")
        cancelar.connect("clicked", lambda *_: dlg.close())
        gravar = Gtk.Button(label="💾 Salvar")
        gravar.add_css_class("botao-verde")
        gravar.connect("clicked", salvar)
        botoes.append(cancelar)
        botoes.append(gravar)
        caixa.append(botoes)
        dlg.set_child(caixa)
        dlg.present()

    def ao_clicar_sobre(self, acao, parametro):
        sobre = Gtk.AboutDialog()
        sobre.set_transient_for(self)
        sobre.set_modal(True)
        sobre.set_program_name("VoidBR XFCE Tweaks")
        sobre.set_version(VERSAO)
        sobre.set_comments("Ajustes visuais do VoidBR XFCE:\n"
                           "picom, transparências, cortile, tema da moldura\n"
                           "Visual Mac (X11 e Wayland) e teclado (Wayland).")
        sobre.set_authors(["Vilmar Catafesta <vcatafesta@gmail.com>"])
        sobre.set_copyright("© 2026 Vilmar Catafesta")
        sobre.set_website("https://voidbr.org")
        sobre.set_website_label("voidbr.org")
        sobre.set_license_type(Gtk.License.BSD)
        sobre.set_logo_icon_name("preferences-desktop-theme")
        sobre.present()


class AppTweaks(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.voidbr.XfceTweaks",
                         flags=getattr(Gio.ApplicationFlags, "DEFAULT_FLAGS", Gio.ApplicationFlags.FLAGS_NONE))
        self.abrir_teclado = False
        # "app.teclado": usado pelo --teclado quando o app já está aberto
        acao = Gio.SimpleAction.new("teclado", None)
        acao.connect("activate", lambda *_: self._mostrar_teclado())
        self.add_action(acao)

    def _mostrar_teclado(self):
        self.abrir_teclado = True
        self.activate()

    def do_activate(self):
        janela = self.props.active_window or JanelaTweaks(self)
        if self.abrir_teclado:
            janela.abrir_aba_teclado()
            self.abrir_teclado = False
        janela.present()


if __name__ == "__main__":
    import sys
    if "--reset-font" in sys.argv[1:]:
        # escape caso uma fonte deixe a janela ilegível
        gravar_prefs_app(font_family="", font_scale=1.0)
        print("voidbr-xfce-tweaks: fonte voltou ao padrão do sistema")
    if "--corrigir" in sys.argv[1:]:
        # sem janela: correções de login (voidbr-mac-sessao)
        for feito in corrigir_sessao():
            print(f"voidbr-xfce-tweaks: {feito}")
        sys.exit(0)
    app = AppTweaks()
    if "--teclado" in sys.argv[1:]:
        # abre direto na aba Teclado (voidbr-teclado no Wayland)
        app.register(None)
        if app.get_is_remote():
            app.activate_action("teclado", None)
            sys.exit(0)
        app.abrir_teclado = True
    app.run(None)
