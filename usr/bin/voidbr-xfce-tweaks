# ---------------------------------------------------------------------------
#   preferências do app (fonte)
# ---------------------------------------------------------------------------

def _familia_segura(nome):
    """Nome de fonte para o CSS (sem aspas/chaves que quebrem a regra)."""
    return re.sub(r"[^\w .,+-]", "", str(nome or "")).strip()[:80]


def ler_prefs_app():
    try:
        with open(PREFS_APP, encoding="utf-8") as f:
            dados = json.load(f)
        return dados if isinstance(dados, dict) else {}
    except (OSError, ValueError):
        return {}


def gravar_prefs_app(**valores):
    dados = ler_prefs_app()
    dados.update(valores)
    os.makedirs(os.path.dirname(PREFS_APP), exist_ok=True)
    with open(PREFS_APP, "w", encoding="utf-8") as f:
        json.dump(dados, f, indent=2, ensure_ascii=False)
        f.write("\n")


# ---------------------------------------------------------------------------
#   xfconf
# ---------------------------------------------------------------------------

def _xfconf(args):
    """Roda xfconf-query em locale C (números sempre com ponto)."""
    ambiente = dict(os.environ, LC_ALL="C")
    try:
        r = subprocess.run(["xfconf-query"] + args, capture_output=True,
                           text=True, env=ambiente)
    except FileNotFoundError:
        return None
    if r.returncode != 0:
        return None
    return r.stdout


def xfconf_ler(canal, prop):
    saida = _xfconf(["-c", canal, "-p", prop])
    return saida.strip() if saida is not None else None


def xfconf_ler_lista(canal, prop):
    """Lê uma propriedade do tipo array e devolve os itens como texto."""
    saida = _xfconf(["-c", canal, "-p", prop])
    if saida is None:
        return []
    itens = []
    for linha in saida.splitlines()[1:]:
        linha = linha.strip()
        if linha:
            itens.append(linha)
    return itens


def xfconf_gravar(canal, prop, tipo, valor):
    _xfconf(["-c", canal, "-p", prop, "-n", "-t", tipo, "-s", str(valor)])


def xfconf_gravar_rgba(canal, prop, valores):
    args = ["-c", canal, "-p", prop, "-n"]
    for _ in valores:
        args += ["-t", "double"]
    for v in valores:
        args += ["-s", f"{v:.6f}"]
    _xfconf(args)


def ids_paineis():
    return [i for i in xfconf_ler_lista("xfce4-panel", "/panels") if i.isdigit()]


def ids_whisker():
    saida = _xfconf(["-c", "xfce4-panel", "-lv"]) or ""
    ids = []
    for linha in saida.splitlines():
        m = re.match(r"^/plugins/plugin-(\d+)\s+whiskermenu\s*$", linha)
        if m:
            ids.append(m.group(1))
    return ids


# ---------------------------------------------------------------------------
#   arquivos
# ---------------------------------------------------------------------------

def ler_arquivo(caminho):
    try:
        with open(caminho, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def gravar_arquivo(caminho, texto):
    os.makedirs(os.path.dirname(caminho), exist_ok=True)
    temporario = caminho + ".tmp"
    with open(temporario, "w", encoding="utf-8") as f:
        f.write(texto)
    os.replace(temporario, caminho)


def remover_bloco(texto, inicio, fim):
    padrao = re.compile(r"\n?" + re.escape(inicio) + r".*?" + re.escape(fim) + r"\n?", re.S)
    return padrao.sub("\n", texto).rstrip("\n") + "\n"


def trocar_linha(texto, chave, novo_valor):
    """Troca 'chave = valor;' no topo do picom.conf (ou acrescenta no fim)."""
    padrao = re.compile(r"^" + re.escape(chave) + r"\s*=\s*[^;]*;", re.M)
    if padrao.search(texto):
        return padrao.sub(f"{chave} = {novo_valor};", texto, count=1)
    return texto.rstrip("\n") + f"\n{chave} = {novo_valor};\n"


# ----- picom -----

def ler_picom():
    texto = ler_arquivo(PICOM_CONF)
    v = {}
    m = re.search(r"^corner-radius\s*=\s*(\d+)\s*;", texto, re.M)
    v["raio"] = int(m.group(1)) if m else PADRAO["raio"]
    m = re.search(r"^\s*strength\s*=\s*(\d+)\s*;", texto, re.M)
    forca = int(m.group(1)) if m else PADRAO["blur"]
    m = re.search(r"^\s*background\s*=\s*(true|false)\s*;", texto, re.M)
    blur_ligado = (m.group(1) == "true") if m else True
    v["blur"] = forca if blur_ligado else 0
    m = re.search(r"^shadow\s*=\s*(true|false)\s*;", texto, re.M)
    v["sombras"] = (m.group(1) == "true") if m else PADRAO["sombras"]
    m = re.search(r"^fading\s*=\s*(true|false)\s*;", texto, re.M)
    v["fade"] = (m.group(1) == "true") if m else PADRAO["fade"]
    m = re.search(r'"(\d+):window_type = \'normal\' && focused"', texto)
    v["janela_foco"] = int(m.group(1)) if m else 100
    m = re.search(r'"(\d+):window_type = \'normal\' && !focused"', texto)
    v["janela_fundo"] = int(m.group(1)) if m else 100
    return v


def gravar_picom(v):
    texto = ler_arquivo(PICOM_CONF)
    if not texto:
        texto = ler_arquivo("/etc/skel/.config/picom/picom.conf")
    texto = trocar_linha(texto, "corner-radius", int(v["raio"]))
    texto = trocar_linha(texto, "shadow", "true" if v["sombras"] else "false")
    texto = trocar_linha(texto, "fading", "true" if v["fade"] else "false")
    if v["blur"] > 0:
        texto = re.sub(r"^(\s*strength\s*=\s*)\d+(\s*;)", rf"\g<1>{int(v['blur'])}\g<2>",
                       texto, count=1, flags=re.M)
        texto = re.sub(r"^(\s*background\s*=\s*)(true|false)(\s*;)", r"\g<1>true\g<3>",
                       texto, count=1, flags=re.M)
    else:
        texto = re.sub(r"^(\s*background\s*=\s*)(true|false)(\s*;)", r"\g<1>false\g<3>",
                       texto, count=1, flags=re.M)

    texto = remover_bloco(texto, INICIO_BLOCO, FIM_BLOCO)
    foco, fundo = int(v["janela_foco"]), int(v["janela_fundo"])
    if foco < 100 or fundo < 100:
        regras = REGRAS_OPACAS + [
            f"{foco}:window_type = 'normal' && focused",
            f"{fundo}:window_type = 'normal' && !focused",
            f"{foco}:window_type = 'dialog'",
        ]
        linhas = ",\n".join(f'  "{r}"' for r in regras)
        texto += (f"\n{INICIO_BLOCO} (gerado pelo voidbr-xfce-tweaks)\n"
                  f"opacity-rule = [\n{linhas}\n];\n{FIM_BLOCO}\n")
    gravar_arquivo(PICOM_CONF, texto)


# ----- gtk.css (menus) -----

def ler_menus():
    texto = ler_arquivo(GTK_CSS)
    bloco = re.search(re.escape(INICIO_CSS) + r"(.*?)" + re.escape(FIM_CSS), texto, re.S)
    alvo = bloco.group(1) if bloco else texto
    m = re.search(r"menu[^{]*\{[^}]*rgba\(\s*\d+,\s*\d+,\s*\d+,\s*([0-9.]+)\s*\)", alvo)
    return round(float(m.group(1)) * 100) if m else PADRAO["menus"]


def gravar_menus(opacidade, fundo=None):
    """Grava a opacidade dos menus; `fundo` é a cor (FUNDO_VOIDBR ou FUNDO_MAC[...])."""
    fundo = fundo or FUNDO_VOIDBR
    r, g, b = fundo["css"]
    texto = remover_bloco(ler_arquivo(GTK_CSS), INICIO_CSS, FIM_CSS)
    a = opacidade / 100.0
    dica = min(1.0, a + 0.05)
    texto += (f"\n{INICIO_CSS}\n"
              f"menu, .menu, .context-menu {{ background-color: rgba({r}, {g}, {b}, {a:.2f}); }}\n"
              f"tooltip, tooltip.background {{ background-color: rgba({r}, {g}, {b}, {dica:.2f}); }}\n"
              f"#whiskermenu-window {{ background-color: {fundo['whisker']}; }}\n"
              f"{FIM_CSS}\n")
    gravar_arquivo(GTK_CSS, texto)


# ----- cortile -----

def ler_cortile():
    texto = ler_arquivo(CORTILE_CONF)
    m = re.search(r'^tiling_layout\s*=\s*"([^"]+)"', texto, re.M)
    layout = m.group(1) if m else PADRAO["layout"]
    m = re.search(r"^window_gap_size\s*=\s*(\d+)", texto, re.M)
    espaco = int(m.group(1)) if m else PADRAO["espaco"]
    return layout, espaco


def gravar_cortile(layout, espaco):
    texto = ler_arquivo(CORTILE_CONF)
    if not texto:
        texto = ler_arquivo("/etc/skel/.config/cortile/config.toml")
    if not texto:
        return
    texto = re.sub(r'^tiling_layout\s*=\s*"[^"]*"', f'tiling_layout = "{layout}"',
                   texto, count=1, flags=re.M)
    texto = re.sub(r"^window_gap_size\s*=\s*\d+", f"window_gap_size = {int(espaco)}",
                   texto, count=1, flags=re.M)
    gravar_arquivo(CORTILE_CONF, texto)


def tiling_ligado():
    """Escolha salva do usuário: o autostart do cortile (Hidden=true = desligado).

    Não usa o processo em execução, para que um cortile que caiu não faça o
    Aplicar desligar o mosaico de vez.
    """
    texto = ler_arquivo(os.path.join(CONFIG, "autostart", "cortile.desktop"))
    if not texto:
        return False
    m = re.search(r"^Hidden\s*=\s*(\S+)", texto, re.M)
    return not (m and m.group(1).lower() == "true")


# ----- modo do compositor -----

def ler_modo():
    modo = ler_arquivo(MODO_COMPOSITOR).strip()
    return modo if modo in [m for m, _ in MODOS] else PADRAO["modo"]


def gravar_modo(modo):
    gravar_arquivo(MODO_COMPOSITOR, modo + "\n")


# ----- temas do xfwm4 -----

def listar_temas_xfwm4():
    pastas = [
        os.path.expanduser("~/.themes"),
        os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "themes"),
        "/usr/share/themes",
    ]
    temas = set()
    for pasta in pastas:
        try:
            for nome in os.listdir(pasta):
                if os.path.isfile(os.path.join(pasta, nome, "xfwm4", "themerc")):
                    temas.add(nome)
        except OSError:
            pass
    return sorted(temas, key=str.lower)


# ---------------------------------------------------------------------------
#   sessão (X11 ou Wayland)
# ---------------------------------------------------------------------------

def sessao_wayland():
    """XFCE em Wayland (labwc): sem xfwm4, picom e cortile."""
    return (os.environ.get("XDG_SESSION_TYPE") == "wayland"
            or bool(os.environ.get("WAYLAND_DISPLAY")))


def rodar(cmd, **kw):
    """Roda um comando sem derrubar o app se ele não existir."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, **kw)
    except (OSError, subprocess.TimeoutExpired):
        return None


# ---------------------------------------------------------------------------
#   visual Mac
# ---------------------------------------------------------------------------

def nome_tema_mac(aparencia, cor):
    return f"VoidBR-Mac-{aparencia}" + (f"-{cor}" if cor else "")


def temas_mac_instalados():
    return os.path.isdir(os.path.join(TEMAS_DIR, "VoidBR-Mac-Light"))


def ler_estado_mac():
    estado = {"ativo": False, "aparencia": PADRAO["mac_aparencia"], "cor": PADRAO["mac_cor"],
              "layout": PADRAO["mac_layout"], "layout_aplicado": False, "anterior": {}}
    try:
        with open(MAC_ESTADO, encoding="utf-8") as f:
            estado.update(json.load(f))
    except (OSError, ValueError):
        pass
    return estado


def gravar_estado_mac(estado):
    gravar_arquivo(MAC_ESTADO, json.dumps(estado, indent=2, ensure_ascii=False) + "\n")


def gsettings_ler(chave):
    r = rodar(["gsettings", "get", "org.gnome.desktop.interface", chave])
    return r.stdout.strip().strip("'") if r and r.returncode == 0 else None


def gsettings_gravar(chave, valor):
    if valor is not None:
        rodar(["gsettings", "set", "org.gnome.desktop.interface", chave, valor])


# ----- GTK4 / libadwaita -----

def _link_nosso(caminho):
    return os.path.islink(caminho) and os.readlink(caminho).startswith(
        os.path.join(TEMAS_DIR, "VoidBR-Mac-"))


def gtk4_ligar(tema):
    """Os apps libadwaita ignoram o tema GTK: liga o CSS do tema em ~/.config/gtk-4.0.

    Só cria/troca links nossos; um gtk.css próprio do usuário é mantido.
    """
    origem = os.path.join(TEMAS_DIR, tema, "gtk-4.0")
    os.makedirs(GTK4_DIR, exist_ok=True)
    for item in GTK4_ITENS:
        destino = os.path.join(GTK4_DIR, item)
        if os.path.lexists(destino) and not _link_nosso(destino):
            continue
        if os.path.lexists(destino):
            os.remove(destino)
        os.symlink(os.path.join(origem, item), destino)


def gtk4_desligar():
    for item in GTK4_ITENS:
        destino = os.path.join(GTK4_DIR, item)
        if _link_nosso(destino):
            os.remove(destino)


# ----- labwc (Wayland) -----

def _labwc_abrir():
    if not os.path.isfile(LABWC_RC):
        os.makedirs(os.path.dirname(LABWC_RC), exist_ok=True)
        if os.path.isfile(LABWC_PADRAO):
            shutil.copy(LABWC_PADRAO, LABWC_RC)
        else:
            gravar_arquivo(LABWC_RC, '<?xml version="1.0"?>\n<labwc_config>\n</labwc_config>\n')
    parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True))
    return ET.parse(LABWC_RC, parser)


def _labwc_no(pai, caminho):
    no = pai
    for parte in caminho.split("/"):
        filho = no.find(parte)
        if filho is None:
            filho = ET.SubElement(no, parte)
        no = filho
    return no


CHAVES_LABWC = {
    "nome": "theme/name",
    "raio": "theme/cornerRadius",
    "sombras": "theme/dropShadows",
    "botoes": "theme/titlebar/layout",
}


def labwc_ler():
    try:
        raiz = _labwc_abrir().getroot()
    except (OSError, ET.ParseError):
        return {}
    valores = {}
    for chave, caminho in CHAVES_LABWC.items():
        no = raiz.find(caminho)
        valores[chave] = no.text.strip() if no is not None and no.text else None
    return valores


def labwc_gravar(valores, restaurar=False):
    """Grava no rc.xml do labwc as chaves com valor.

    Com restaurar=True, as chaves que não existiam antes (None) são removidas.
    """
    arvore = _labwc_abrir()
    raiz = arvore.getroot()
    for chave, caminho in CHAVES_LABWC.items():
        if chave not in valores:
            continue
        if valores[chave] is not None:
            _labwc_no(raiz, caminho).text = str(valores[chave])
        elif restaurar:
            pai_caminho, _, folha = caminho.rpartition("/")
            pai = raiz.find(pai_caminho)
            no = pai.find(folha) if pai is not None else None
            if no is not None:
                pai.remove(no)
                # não deixa um <titlebar> vazio para trás
                avo_caminho = pai_caminho.rpartition("/")[0]
                avo = raiz.find(avo_caminho) if avo_caminho else None
                if avo is not None and len(pai) == 0 and not (pai.text or "").strip():
                    avo.remove(pai)
    ET.indent(arvore, space="  ")
    arvore.write(LABWC_RC, encoding="UTF-8", xml_declaration=True)
    if sessao_wayland():
        rodar(["labwc", "--reconfigure"], timeout=10)


def labwc_tema_existe(nome):
    """O labwc só acha temas com pasta labwc/ ou openbox-3/ (labwc-theme(5))."""
    if not nome:
        return False
    dados = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    bases = [os.path.join(dados, "themes"), os.path.expanduser("~/.themes"),
             "/usr/share/themes", "/usr/local/share/themes", "/opt/share/themes"]
    return any(os.path.isfile(os.path.join(b, nome, sub, "themerc"))
               for b in bases for sub in ("labwc", "openbox-3"))


# ----- correções no login (--corrigir, chamado pelo voidbr-mac-sessao) -----

def _tema_escuro(nome):
    nome = (nome or "").lower()
    return any(p in nome for p in ("dark", "nokto", "night", "noir", "black"))


def corrigir_sessao():
    """Acerta estados quebrados que a atualização (--only-new) não alcança.

    Só troca o que está quebrado; nunca uma escolha válida do usuário.
    Devolve a lista do que foi corrigido.
    """
    feitos = []
    estado = ler_estado_mac()

    if estado.get("ativo"):
        # o "anterior" é o que volta ao desligar o Visual Mac
        anterior = estado.get("anterior") or {}
        mudou = False
        labwc = anterior.get("labwc")
        if labwc and not labwc_tema_existe(labwc.get("nome")):
            labwc["nome"] = LABWC_TEMA_VOIDBR
            mudou = True
        if not anterior.get("gtk_gsettings") and anterior.get("gtk"):
            anterior["gtk_gsettings"] = anterior["gtk"]
            if not anterior.get("esquema") and _tema_escuro(anterior["gtk"]):
                anterior["esquema"] = "prefer-dark"
            mudou = True
        if mudou:
            gravar_estado_mac(estado)
            feitos.append("mac.json: visual anterior")
        return feitos

    if sessao_wayland() and os.path.isfile(LABWC_RC):
        try:
            nome = labwc_ler().get("nome")
            if not labwc_tema_existe(nome) and labwc_tema_existe(LABWC_TEMA_VOIDBR):
                labwc_gravar({"nome": LABWC_TEMA_VOIDBR})
                feitos.append(f"labwc: tema {nome or '(vazio)'} -> {LABWC_TEMA_VOIDBR}")
        except (OSError, ET.ParseError):
            pass

    gtk_gs = gsettings_ler("gtk-theme")
    if gtk_gs and gtk_gs.startswith("VoidBR-Mac"):
        gtk = xfconf_ler("xsettings", "/Net/ThemeName")
        if gtk and not gtk.startswith("VoidBR-Mac"):
            gsettings_gravar("gtk-theme", gtk)
            if _tema_escuro(gtk):
                gsettings_gravar("color-scheme", "prefer-dark")
            feitos.append(f"gsettings: tema {gtk_gs} -> {gtk}")
    return feitos


# ----- teclado (Wayland, labwc) -----

def teclado_ler():
    """Lê layouts, modelo e atalho de troca do environment do labwc."""
    env = {}
    for linha in ler_arquivo(LABWC_ENV).splitlines():
        linha = linha.strip()
        if linha and not linha.startswith("#") and "=" in linha:
            chave, valor = linha.split("=", 1)
            env[chave.strip()] = valor.strip().strip('"\'')
    layouts = [x.strip() for x in env.get("XKB_DEFAULT_LAYOUT", "").split(",")]
    variantes = [x.strip() for x in env.get("XKB_DEFAULT_VARIANT", "").split(",")]
    for i, var in enumerate(variantes):
        if var and i < len(layouts) and layouts[i] and "(" not in layouts[i]:
            layouts[i] = f"{layouts[i]}({var})"
    layouts = [x for x in layouts if x]
    troca = next((o for o in env.get("XKB_DEFAULT_OPTIONS", "").split(",")
                  if o.strip().startswith("grp:")), "")
    return {
        "kb_layout1": layouts[0] if layouts else "us",   # sem layout, o labwc usa "us"
        "kb_layout2": layouts[1] if len(layouts) > 1 else "",
        "kb_modelo": env.get("XKB_DEFAULT_MODEL", "") or "pc105",
        "kb_troca": troca.strip(),
    }


def teclado_gravar(v):
    """Grava o teclado no environment do labwc, mantendo as outras linhas.
    Devolve True se mudou algo."""
    layouts = ",".join(x for x in (v["kb_layout1"], v["kb_layout2"]) if x)
    texto = ler_arquivo(LABWC_ENV)
    opcoes = []
    for linha in texto.splitlines():
        if linha.strip().startswith("XKB_DEFAULT_OPTIONS="):
            opcoes = [o.strip() for o in linha.split("=", 1)[1].strip().strip('"\'').split(",")
                      if o.strip() and not o.strip().startswith("grp:")]
    if v["kb_troca"] and v["kb_layout2"]:
        opcoes.insert(0, v["kb_troca"])
    novas = {
        "XKB_DEFAULT_MODEL": v["kb_modelo"],
        "XKB_DEFAULT_LAYOUT": layouts,
        "XKB_DEFAULT_OPTIONS": ",".join(opcoes),
    }
    saida, vistas = [], set()
    for linha in texto.splitlines():
        chave = linha.split("=", 1)[0].strip() if "=" in linha else ""
        if chave == "XKB_DEFAULT_VARIANT":
            continue        # a variante vai junto do layout: br(nodeadkeys)
        if chave in novas and not linha.lstrip().startswith("#"):
            if chave not in vistas and novas[chave]:
                saida.append(f"{chave}={novas[chave]}")
            vistas.add(chave)
            continue
        saida.append(linha)
    for chave, valor in novas.items():
        if chave not in vistas and valor:
            saida.append(f"{chave}={valor}")
    novo = "\n".join(saida).strip("\n") + "\n"
    mudou = novo != texto
    if mudou:
        gravar_arquivo(LABWC_ENV, novo)
    if not os.path.exists(LABWC_LOCK):
        gravar_arquivo(LABWC_LOCK, "")
    if mudou and sessao_wayland():
        rodar(["labwc", "--reconfigure"], timeout=10)
    return mudou


# ----- painéis -----

def _esperar_sair(processo, segundos=5):
    fim = time.time() + segundos
    while time.time() < fim:
        r = rodar(["pgrep", "-u", str(os.getuid()), "-x", processo])
        if not r or r.returncode != 0:
            return
        time.sleep(0.2)


def painel_trocar(xml_texto, pasta_plugins, substituir_pasta=False):
    """Troca a configuração inteira dos painéis.

    Fecha o painel e o xfconfd (que grava o cache dele ao sair), escreve o XML e os
    arquivos dos plugins e abre o painel de novo.
    """
    rodar(["xfce4-panel", "--quit"], timeout=10)
    _esperar_sair("xfce4-panel")
    rodar(["pkill", "-u", str(os.getuid()), "-x", "xfconfd"])
    _esperar_sair("xfconfd")
    gravar_arquivo(PAINEL_XML, xml_texto)
    if substituir_pasta and os.path.isdir(pasta_plugins):
        shutil.rmtree(PAINEL_PLUGINS, ignore_errors=True)
    if os.path.isdir(pasta_plugins):
        shutil.copytree(pasta_plugins, PAINEL_PLUGINS, dirs_exist_ok=True)
    subprocess.Popen(["xfce4-panel"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    time.sleep(2)


def pasta_downloads():
    r = rodar(["xdg-user-dir", "DOWNLOAD"])
    pasta = r.stdout.strip() if r and r.returncode == 0 else ""
    return pasta if pasta and pasta != os.path.expanduser("~") else os.path.expanduser("~/Downloads")


def painel_mac(aparencia):
    xml_texto = ler_arquivo(os.path.join(MAC_DIR, "xfce4-panel.xml"))
    if not xml_texto:
        raise OSError(f"layout Mac não encontrado em {MAC_DIR}")
    xml_texto = (xml_texto.replace("@DOWNLOAD@", pasta_downloads())
                 .replace("@DARK@", "true" if aparencia == "Dark" else "false"))
    painel_trocar(xml_texto, os.path.join(MAC_DIR, "panel"))


def painel_backup():
    os.makedirs(MAC_BACKUP, exist_ok=True)
    if os.path.isfile(PAINEL_XML):
        shutil.copy(PAINEL_XML, os.path.join(MAC_BACKUP, "xfce4-panel.xml"))
    if os.path.isdir(PAINEL_PLUGINS):
        shutil.copytree(PAINEL_PLUGINS, os.path.join(MAC_BACKUP, "panel"), dirs_exist_ok=True)


def painel_restaurar():
    xml_texto = ler_arquivo(os.path.join(MAC_BACKUP, "xfce4-panel.xml"))
    if not xml_texto:
        return False
    painel_trocar(xml_texto, os.path.join(MAC_BACKUP, "panel"), substituir_pasta=True)
    return True


# ----- Plank (a dock do layout Mac é o docklike do painel) -----

def plank_esconder():
    """Desliga o Plank do autostart do usuário. Devolve True se mudou algo."""
    texto = ler_arquivo(PLANK_AUTOSTART)
    if not texto or re.search(r"^Hidden\s*=\s*true", texto, re.M | re.I):
        return False
    if re.search(r"^Hidden\s*=", texto, re.M):
        texto = re.sub(r"^Hidden\s*=.*$", "Hidden=true", texto, flags=re.M)
    else:
        texto = texto.rstrip("\n") + "\nHidden=true\n"
    gravar_arquivo(PLANK_AUTOSTART, texto)
    rodar(["pkill", "-u", str(os.getuid()), "-x", "plank"])
    return True


def plank_mostrar():
    """Liga o Plank no autostart e já abre (voidbr-plank: X11 ou XWayland)."""
    texto = ler_arquivo(PLANK_AUTOSTART)
    if texto:
        texto = re.sub(r"^Hidden\s*=.*$", "Hidden=false", texto, flags=re.M)
        texto = re.sub(r"^Exec\s*=\s*plank\s*$", "Exec=voidbr-plank", texto, flags=re.M)
        gravar_arquivo(PLANK_AUTOSTART, texto)
        try:
            subprocess.Popen(["voidbr-plank"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass


# ----- ligar / desligar -----

def mac_aplicar(v, estado):
    """Aplica o visual Mac (tema, moldura, painéis). Atualiza e devolve o estado."""
    tema = nome_tema_mac(v["mac_aparencia"], v["mac_cor"])
    moldura = f"VoidBR-Mac-{v['mac_aparencia']}"
    if not os.path.isdir(os.path.join(TEMAS_DIR, tema)):
        raise OSError(f"tema {tema} não instalado (pacote voidbr-mac-themes)")

    if not estado["ativo"]:
        # primeira vez: guarda o visual atual para o "desligar" voltar a ele
        anterior = {
            "gtk": xfconf_ler("xsettings", "/Net/ThemeName"),
            "xfwm4": xfconf_ler("xfwm4", "/general/theme"),
            "botoes": xfconf_ler("xfwm4", "/general/button_layout"),
            "gtk_gsettings": gsettings_ler("gtk-theme"),
            "esquema": gsettings_ler("color-scheme"),
            "labwc": labwc_ler() if (sessao_wayland() or os.path.isfile(LABWC_RC)) else {},
            "plank": False,
        }
        estado["anterior"] = anterior
        estado["ativo"] = True

    xfconf_gravar("xsettings", "/Net/ThemeName", "string", tema)
    xfconf_gravar("xfwm4", "/general/theme", "string", moldura)
    xfconf_gravar("xfwm4", "/general/button_layout", "string", "CHM|")
    gsettings_gravar("gtk-theme", tema)
    gsettings_gravar("color-scheme", "prefer-dark" if v["mac_aparencia"] == "Dark" else "default")
    gtk4_ligar(tema)
    if sessao_wayland() or os.path.isfile(LABWC_RC):
        labwc_gravar({"nome": moldura, "raio": int(v["raio"]),
                      "sombras": "yes" if v["sombras"] else "no", "botoes": LABWC_SEMAFOROS})

    if v["mac_layout"] and not estado["layout_aplicado"]:
        painel_backup()
        painel_mac(v["mac_aparencia"])
        estado["layout_aplicado"] = True
        estado["anterior"]["plank"] = plank_esconder()
    elif not v["mac_layout"] and estado["layout_aplicado"]:
        painel_restaurar()
        estado["layout_aplicado"] = False
        if estado["anterior"].get("plank"):
            plank_mostrar()
    elif estado["layout_aplicado"]:
        xfconf_gravar("xfce4-panel", "/panels/dark-mode", "bool",
                      "true" if v["mac_aparencia"] == "Dark" else "false")

    estado.update({"aparencia": v["mac_aparencia"], "cor": v["mac_cor"], "layout": v["mac_layout"]})
    gravar_estado_mac(estado)
    return estado


def mac_desligar(estado):
    """Volta ao visual de antes do visual Mac. Devolve o tema do xfwm4 restaurado."""
    anterior = estado.get("anterior", {})
    if estado.get("layout_aplicado"):
        painel_restaurar()
        if anterior.get("plank"):
            plank_mostrar()
    if anterior.get("gtk"):
        xfconf_gravar("xsettings", "/Net/ThemeName", "string", anterior["gtk"])
    if anterior.get("xfwm4"):
        xfconf_gravar("xfwm4", "/general/theme", "string", anterior["xfwm4"])
    if anterior.get("botoes"):
        xfconf_gravar("xfwm4", "/general/button_layout", "string", anterior["botoes"])
    # mac.json antigo podia ter o tema do gsettings vazio: usa o do xfconf
    gsettings_gravar("gtk-theme", anterior.get("gtk_gsettings") or anterior.get("gtk"))
    gsettings_gravar("color-scheme", anterior.get("esquema"))
    gtk4_desligar()
    if anterior.get("labwc"):
        labwc = dict(anterior["labwc"])
        # tema que o labwc não acha (ex.: "Adwaita") cai no padrão embutido, que é claro
        if not labwc_tema_existe(labwc.get("nome")):
            labwc["nome"] = LABWC_TEMA_VOIDBR
        labwc_gravar(labwc, restaurar=True)
    shutil.rmtree(MAC_BACKUP, ignore_errors=True)
    gravar_estado_mac({"ativo": False, "aparencia": estado.get("aparencia", "Dark"),
                       "cor": estado.get("cor", ""), "layout": estado.get("layout", True),
                       "layout_aplicado": False, "anterior": {}})
    return anterior.get("xfwm4")


# ---------------------------------------------------------------------------
#   janela
# ---------------------------------------------------------------------------

class JanelaTweaks(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="voidbr-xfce-tweaks")
        self.set_default_size(620, 560)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # tamanho e família da fonte (A− / A+ / Ctrl+ Ctrl- Ctrl0), gravados em PREFS_APP
        self.css_fonte = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(), self.css_fonte, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        prefs = ler_prefs_app()
        try:
            self.escala = min(ESCALA_MAX, max(ESCALA_MIN, float(prefs.get("font_scale", 1.0))))
        except (TypeError, ValueError):
            self.escala = 1.0
        self.familia = _familia_segura(prefs.get("font_family", ""))

        # --- Barra de título: fonte à esquerda, menu (☰) à direita ---
        cabecalho = Gtk.HeaderBar()
        cabecalho.add_css_class("cabecalho-app")
        self.set_titlebar(cabecalho)

        fonte = Gtk.Box(spacing=0)
        fonte.add_css_class("linked")
        self.b_menor = Gtk.Button(label="A−", tooltip_text="Diminuir a fonte (Ctrl -)")
        self.b_escala = Gtk.Button(label="100%", tooltip_text="Tamanho normal (Ctrl 0)")
        self.b_maior = Gtk.Button(label="A+", tooltip_text="Aumentar a fonte (Ctrl +)")
        for b, passo in ((self.b_menor, -1), (self.b_escala, 0), (self.b_maior, 1)):
            b.add_css_class("botao-fonte")
            b.connect("clicked", lambda _b, p=passo: self.mudar_fonte(p))
            fonte.append(b)
        cabecalho.pack_start(fonte)

        menu_modelo = Gio.Menu()
        menu_modelo.append("🔤 Aparência (fonte)…", "win.aparencia")
        menu_modelo.append("ℹ️ Sobre / Créditos", "win.sobre")
        botao_menu = Gtk.MenuButton()
        botao_menu.set_icon_name("open-menu-symbolic")
        botao_menu.set_menu_model(menu_modelo)
        botao_menu.add_css_class("botao-menu")
        cabecalho.pack_end(botao_menu)

        acao_sobre = Gio.SimpleAction.new("sobre", None)
        acao_sobre.connect("activate", self.ao_clicar_sobre)
        self.add_action(acao_sobre)
        for nome, cb in (("aparencia", self.ao_clicar_aparencia),
                         ("fonte_mais", lambda *_: self.mudar_fonte(1)),
                         ("fonte_menos", lambda *_: self.mudar_fonte(-1)),
                         ("fonte_normal", lambda *_: self.mudar_fonte(0))):
            acao = Gio.SimpleAction.new(nome, None)
            acao.connect("activate", cb)
            self.add_action(acao)
        app.set_accels_for_action("win.fonte_mais", ["<Control>plus", "<Control>equal",
                                                     "<Control>KP_Add"])
        app.set_accels_for_action("win.fonte_menos", ["<Control>minus", "<Control>KP_Subtract"])
        app.set_accels_for_action("win.fonte_normal", ["<Control>0", "<Control>KP_0"])
        self.aplicar_fonte()

        caixa = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        caixa.set_margin_top(16)
        caixa.set_margin_bottom(16)
        caixa.set_margin_start(16)
        caixa.set_margin_end(16)
        self.set_child(caixa)

        titulo = Gtk.Label(label="🎨 VoidBR XFCE Tweaks", xalign=0)
        titulo.add_css_class("titulo-app")
        caixa.append(titulo)
        sub = Gtk.Label(label="Efeitos, transparências, mosaico, moldura, Visual Mac e teclado",
                        xalign=0)
        sub.add_css_class("subtitulo")
        caixa.append(sub)

        abas = self.abas = Gtk.Notebook()
        abas.set_vexpand(True)
        abas.append_page(self._aba_efeitos(), Gtk.Label(label="✨ Efeitos"))
        abas.append_page(self._aba_transparencia(), Gtk.Label(label="💧 Transparência"))
        abas.append_page(self._aba_mosaico(), Gtk.Label(label="🧩 Mosaico"))
        abas.append_page(self._aba_moldura(), Gtk.Label(label="🪟 Moldura"))
        abas.append_page(self._aba_mac(), Gtk.Label(label="🍎 Visual Mac"))
        self.pagina_teclado = abas.append_page(self._aba_teclado(),
                                               Gtk.Label(label="⌨️ Teclado"))
        caixa.append(abas)

        # --- Status ---
        caixa_status = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        caixa_status.add_css_class("caixa-status")
        self.label_status = Gtk.Label(label="", xalign=0)
        self.label_status.set_wrap(True)
        caixa_status.append(self.label_status)
        caixa.append(caixa_status)

        # --- Botões ---
        linha = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        linha.set_halign(Gtk.Align.END)
        self.botao_padrao = Gtk.Button(label="↩️ Padrão VoidBR")
        self.botao_padrao.add_css_class("botao-laranja")
        self.botao_padrao.connect("clicked", self.ao_clicar_padrao)
        self.botao_aplicar = Gtk.Button(label="✅ Aplicar")
        self.botao_aplicar.add_css_class("botao-verde")
        self.botao_aplicar.connect("clicked", self.ao_clicar_aplicar)
        linha.append(self.botao_padrao)
        linha.append(self.botao_aplicar)
        caixa.append(linha)

        self.carregar_valores()

    # ----- construção das abas -----

    def _grade(self):
        grade = Gtk.Grid(column_spacing=14, row_spacing=12)
        grade.set_margin_top(14)
        grade.set_margin_bottom(14)
        grade.set_margin_start(14)
        grade.set_margin_end(14)
        grade._linha = 0
        return grade

    def _rotulo(self, grade, texto, dica=None):
        rot = Gtk.Label(label=texto, xalign=0)
        rot.add_css_class("rotulo-campo")
        grade.attach(rot, 0, grade._linha, 1, 1)
        if dica:
            d = Gtk.Label(label=dica, xalign=0)
            d.add_css_class("dica")
            d.set_wrap(True)
            grade.attach(d, 0, grade._linha + 1, 3, 1)

    def _escala(self, grade, texto, minimo, maximo, passo, sufixo="", dica=None):
        self._rotulo(grade, texto, dica)
        esc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, minimo, maximo, passo)
        esc.set_hexpand(True)
        esc.set_digits(0)
        esc.set_draw_value(False)
        valor = Gtk.Label(xalign=1)
        valor.set_width_chars(6)
        valor.add_css_class("valor-escala")
        esc.connect("value-changed",
                    lambda e: valor.set_text(f"{int(e.get_value())}{sufixo}"))
        valor.set_text(f"{int(minimo)}{sufixo}")
        grade.attach(esc, 1, grade._linha, 1, 1)
        grade.attach(valor, 2, grade._linha, 1, 1)
        grade._linha += 2 if dica else 1
        return esc

    def _chave(self, grade, texto, dica=None):
        self._rotulo(grade, texto, dica)
        sw = Gtk.Switch()
        sw.set_halign(Gtk.Align.START)
        grade.attach(sw, 1, grade._linha, 1, 1)
        grade._linha += 2 if dica else 1
        return sw

    def _lista(self, grade, texto, opcoes, dica=None):
        self._rotulo(grade, texto, dica)
        dd = Gtk.DropDown.new_from_strings(opcoes)
        dd.set_hexpand(True)
        grade.attach(dd, 1, grade._linha, 1, 1)
        grade._linha += 2 if dica else 1
        return dd

    def _aba_efeitos(self):
        g = self._grade()
        self.dd_modo = self._lista(g, "Compositor", [t for _, t in MODOS],
                                   "Automático: usa o picom quando há aceleração 3D "
                                   "(máquina real ou VM com virgl) e o xfwm4 quando não há.")
        self.esc_blur = self._escala(g, "Desfoque (blur)", 0, 20, 1, "",
                                     "0 desliga o desfoque.")
        self.esc_raio = self._escala(g, "Cantos arredondados", 0, 30, 1, " px")
        self.sw_sombras = self._chave(g, "Sombras")
        self.sw_fade = self._chave(g, "Animação ao abrir/fechar")
        return g

    def _aba_transparencia(self):
        g = self._grade()
        self.esc_foco = self._escala(g, "Janela em foco", 50, 100, 1, " %",
                                     "100 % = opaca. Navegadores, vídeo, GIMP/Inkscape, "
                                     "terminal e tela cheia ficam sempre opacos.")
        self.esc_fundo = self._escala(g, "Janelas de fundo", 50, 100, 1, " %")
        self.esc_painel = self._escala(g, "Painel", 0, 100, 1, " %")
        self.esc_menus = self._escala(g, "Menus e dicas", 30, 100, 1, " %",
                                      "Vale para menus abertos depois de aplicar.")
        self.esc_whisker = self._escala(g, "Menu Whisker", 30, 100, 1, " %")
        self.esc_terminal = self._escala(g, "Terminal", 30, 100, 1, " %",
                                         "O texto do terminal continua nítido.")
        return g

    def _aba_mosaico(self):
        g = self._grade()
        self.sw_tiling = self._chave(g, "Mosaico (cortile)",
                                     "Vem desligado de fábrica. Ao ligar aqui, vale agora e "
                                     "nos próximos logins. Pelo terminal: voidbr-tiling on "
                                     "(liga), voidbr-tiling off (desliga) e voidbr-tiling "
                                     "status (mostra o estado).")
        self.dd_layout = self._lista(g, "Layout inicial", [t for _, t in LAYOUTS],
                                     "Ao trocar, todas as áreas de trabalho passam a usar o "
                                     "novo layout. Maximizar uma janela (ou Ctrl+Shift+Espaço) "
                                     "empilha a área toda; Ctrl+Shift+← volta ao lado a lado.")
        self.esc_espaco = self._escala(g, "Espaço entre janelas", 0, 40, 1, " px")
        atalhos = Gtk.Label(xalign=0)
        atalhos.add_css_class("dica")
        atalhos.set_markup(
            "<b>Atalhos do cortile</b> (só com o mosaico ligado)\n"
            "Ctrl+Shift+T  liga/desliga   •   Ctrl+Shift+setas  muda o layout\n"
            "Ctrl+Shift+PgUp/PgDn  alterna layouts   •   Ctrl+Shift+BackSpace  reinicia proporções"
        )
        g.attach(atalhos, 0, g._linha, 3, 1)
        return g

    def _aba_moldura(self):
        g = self._grade()
        self.temas = listar_temas_xfwm4()
        self.dd_tema = self._lista(g, "Tema do xfwm4", self.temas or ["(nenhum tema encontrado)"],
                                   "Moldura e barra de título das janelas. "
                                   "Muda na hora, sem reiniciar a sessão. "
                                   "Com o Visual Mac ligado, a moldura é a dele.")
        return g

    def _aba_mac(self):
        g = self._grade()
        self.sw_mac = self._chave(g, "Visual Mac",
                                  "Tema estilo macOS (claro ou escuro), botões semáforo à "
                                  "esquerda e cantos arredondados, no X11 e no Wayland. "
                                  "Desligar volta ao visual de antes.")
        self.dd_aparencia = self._lista(g, "Aparência", [t for _, t in APARENCIAS])
        self.dd_cor = self._lista(g, "Cor de destaque", [t for _, t in CORES_MAC],
                                  "Seleções, botões principais e chaves ligadas.")
        self.sw_layout_mac = self._chave(g, "Barra no topo + dock",
                                         "Troca os painéis pelo layout do Mac: barra fina no "
                                         "topo e dock centralizada embaixo, com Downloads e "
                                         "Lixeira. Seus painéis ficam guardados e voltam ao "
                                         "desligar.")
        if not temas_mac_instalados():
            aviso = Gtk.Label(xalign=0)
            aviso.add_css_class("dica")
            aviso.set_wrap(True)
            aviso.set_markup("⚠️ <b>Temas não instalados.</b> Instale o pacote "
                             "<b>voidbr-mac-themes</b> para usar o Visual Mac.")
            g.attach(aviso, 0, g._linha, 3, 1)
            g._linha += 1
            self.sw_mac.set_sensitive(False)
